{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/auscaster/ugt/spec/recipe/v0/recipe.schema.json",
  "title": "UGT recipe (draft 0)",
  "description": "What was run, for which task, on what, and how it was proved. Provisional: fields may change before v1.",
  "type": "object",
  "required": [
    "recipe_format",
    "id",
    "repo",
    "commit",
    "task",
    "route",
    "packaging",
    "platforms_tested",
    "run",
    "check",
    "licence"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "properties": {
    "recipe_format": {
      "const": "ugt-draft-0"
    },
    "id": {
      "description": "<owner>-<repo> in lowercase.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "repo": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "commit": {
      "description": "Full commit SHA the package was built from.",
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "release": {
      "description": "Release artifact used instead of a source build, when applicable.",
      "type": "object",
      "required": ["tag", "artifact", "sha256"],
      "additionalProperties": false,
      "properties": {
        "tag": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "task": {
      "description": "The user's task as an output, in plain words.",
      "type": "string",
      "minLength": 1
    },
    "route": {
      "enum": ["agent-install", "upstream-installer", "native", "container", "compose"]
    },
    "packaging": {
      "enum": ["reused", "adapted", "authored"]
    },
    "packaging_note": {
      "type": "string"
    },
    "platforms_tested": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memory_gb": { "type": "number", "exclusiveMinimum": 0 },
        "disk_gb": { "type": "number", "exclusiveMinimum": 0 },
        "gpu": { "enum": ["none", "optional", "required"] },
        "network_at_run": { "type": "boolean" }
      }
    },
    "user_supplies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "inputs": { "$ref": "#/$defs/files" },
    "outputs": { "$ref": "#/$defs/files" },
    "build": { "$ref": "#/$defs/command" },
    "run": { "$ref": "#/$defs/command" },
    "check": { "$ref": "#/$defs/command" },
    "stop": { "$ref": "#/$defs/command" },
    "remove": { "$ref": "#/$defs/command" },
    "delete_data": { "$ref": "#/$defs/command" },
    "known_issues": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "licence": {
      "description": "SPDX identifier of the upstream project, plus a note if it affects sharing or hosting.",
      "type": "string",
      "minLength": 1
    },
    "verified": {
      "type": "object",
      "required": ["date", "agent", "evidence"],
      "additionalProperties": false,
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "agent": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "command": {
      "description": "Exact shell command, run from the workspace root.",
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "what"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "description": "Workspace-relative path with forward slashes; never absolute, home-relative or escaping the workspace.",
            "type": "string",
            "pattern": "^[^/~\\\\][^\\\\]*$",
            "not": { "pattern": "(^|/)\\.\\.(/|$)" }
          },
          "what": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
