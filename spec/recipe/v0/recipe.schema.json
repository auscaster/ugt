{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/auscaster/ugt/spec/recipe/v0/recipe.schema.json",
  "title": "UGT recipe (draft 3)",
  "description": "What a recipe is, for which task, from which source, where it was proved and what the user must supply. Everything that runs lives in the recipe's compose.yaml. Provisional: recipe_format names the draft, and each breaking change before v1 bumps it.",
  "type": "object",
  "required": [
    "recipe_format",
    "id",
    "repo",
    "commit",
    "task",
    "kind",
    "packaging",
    "platforms_tested",
    "licence"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "properties": {
    "recipe_format": {
      "const": "ugt-draft-3"
    },
    "id": {
      "description": "<owner>/<repo>/<task> in lowercase: the project and the job this recipe does. In the catalogue it matches the folder recipes/<owner>/<repo>/<task>.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,99}/[a-z0-9][a-z0-9._-]{0,99}/[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "repo": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "commit": {
      "description": "Full commit SHA the package was built from.",
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "release": {
      "description": "Release artifact used instead of a source build, when applicable.",
      "type": "object",
      "required": ["tag", "artifact", "sha256"],
      "additionalProperties": false,
      "properties": {
        "tag": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "task": {
      "description": "The user's task as an output, in plain words.",
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "description": "job: the task service runs to completion and writes outputs/. service: the stack keeps running for the user, and a task service is optional.",
      "enum": ["job", "service"]
    },
    "packaging": {
      "enum": ["reused", "adapted", "authored"]
    },
    "packaging_note": {
      "type": "string"
    },
    "adapted_from": {
      "description": "Permanent URL of the Compose file this recipe was adopted from (at a pinned commit), so it can be re-imported when upstream changes.",
      "type": "string",
      "pattern": "^https://"
    },
    "platforms_tested": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "settings": {
      "description": "What the user must supply. Each becomes ${NAME} in compose.yaml; the executor fills it, keeping secrets in the system keychain.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "required", "what"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "An upper-case environment variable name; UGT_, COMPOSE_ and DOCKER_ names belong to the executor.",
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "not": { "pattern": "^(UGT_|COMPOSE_|DOCKER_)" }
          },
          "kind": { "enum": ["secret", "value"] },
          "required": { "type": "boolean" },
          "what": { "type": "string", "minLength": 1 },
          "how": { "description": "Where the user gets it.", "type": "string", "minLength": 1 }
        }
      }
    },
    "inputs": { "$ref": "#/$defs/files" },
    "outputs": { "$ref": "#/$defs/files" },
    "known_issues": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "licence": {
      "description": "SPDX identifier of the upstream project, plus a note if it affects sharing or hosting.",
      "type": "string",
      "minLength": 1
    },
    "verified": {
      "type": "object",
      "required": ["date", "agent", "evidence"],
      "additionalProperties": false,
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "agent": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "what"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "description": "Workspace-relative path under inputs/ or outputs/.",
            "type": "string",
            "pattern": "^(inputs|outputs)/[^\\\\]+$",
            "not": { "pattern": "(^|/)\\.\\.(/|$)" }
          },
          "what": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
