<?xml version="1.0" encoding="UTF-8"?>
<!-- ugt on a Mac runs UGT's own Linux machine on Apple's Virtualization framework, which only a program signed with this entitlement may do. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.virtualization</key>
	<true/>
</dict>
</plist>
